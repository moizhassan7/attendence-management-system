# Copy to .env.docker (never commit). Then:
#   docker compose --env-file .env.docker up --build -d

APP_NAME=Local Attendance System
APP_ENV=production
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Karachi
LOG_LEVEL=INFO

# Compose interpolation + Postgres container
POSTGRES_DB=attendance_db
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=change_me_db_password

# Backend talks to the db service (compose overrides this too)
DATABASE_URL=postgresql+asyncpg://attendance_user:change_me_db_password@db:5432/attendance_db

# Public site origin (HTTP until you add a domain + Let's Encrypt)
FRONTEND_URL=http://182.176.174.69
CORS_ORIGINS=http://182.176.174.69

# Also add your LAN IP if you will open the app from inside the office, e.g.:
# CORS_ORIGINS=http://182.176.174.69,http://192.168.1.50
# FRONTEND_URL=http://182.176.174.69

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_EMAIL=admin@local.attendance
SEED_ON_START=true

# Real ZKTeco on LAN — do not port-forward 4370 to the Internet
USE_MOCK_DEVICE=false
SYNC_INTERVAL_SECONDS=30
DEBOUNCE_SECONDS=60
DEVICE_TIMEOUT_SECONDS=10
DEVICE_CLEAR_LOG_AFTER_SYNC=true

WEEKEND_DAYS=5,6
DEFAULT_SHIFT_START=08:30
DEFAULT_SHIFT_END=17:00
DEFAULT_LATE_GRACE_MINUTES=10
