# ─── Application ───
APP_NAME=Local Attendance System
APP_ENV=development

# ─── Server ───
HOST=0.0.0.0
PORT=8000

# ─── Database ───
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://attendance_user:password@localhost:5432/attendance_db
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./attendance.db

# ─── Timezone ───
TIMEZONE=Asia/Karachi

# ─── ZKTeco Sync ───
SYNC_INTERVAL_SECONDS=30
DEBOUNCE_SECONDS=60
USE_MOCK_DEVICE=true
DEVICE_TIMEOUT_SECONDS=90
DEVICE_CLEAR_LOG_AFTER_SYNC=true

# ─── Authentication ───
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Default Shift ───
DEFAULT_SHIFT_START=08:30
DEFAULT_SHIFT_END=17:00
DEFAULT_LATE_GRACE_MINUTES=10

# ─── Business Days ───
# Comma-separated day numbers (0=Mon, 6=Sun)
WEEKEND_DAYS=5,6

# ─── Frontend ───
FRONTEND_URL=http://localhost:5173
# Extra origins (comma-separated). Docker/public access example:
# CORS_ORIGINS=http://182.176.174.69,http://192.168.1.50

# Create admin/shifts/device on startup if missing
SEED_ON_START=true

# ─── Admin Seed ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@local.attendance

# ─── Logging ───
LOG_LEVEL=INFO
