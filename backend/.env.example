# Copy this file to .env in the same folder:
#   copy .env.example .env

APP_NAME=Local Attendance System
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Easiest for a new PC: SQLite (no Postgres install needed)
DATABASE_URL=sqlite+aiosqlite:///./attendance.db

# If you install PostgreSQL instead, use this and comment out SQLite above:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/zkt

TIMEZONE=Asia/Karachi
SYNC_INTERVAL_SECONDS=30
DEBOUNCE_SECONDS=60

# true = no real ZKTeco device required
USE_MOCK_DEVICE=true
DEVICE_TIMEOUT_SECONDS=90
DEVICE_CLEAR_LOG_AFTER_SYNC=true

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DEFAULT_SHIFT_START=08:30
DEFAULT_SHIFT_END=17:00
DEFAULT_LATE_GRACE_MINUTES=10
WEEKEND_DAYS=5,6

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SEED_ON_START=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@local.attendance

LOG_LEVEL=INFO
